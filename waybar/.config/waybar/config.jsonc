{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 6,

  "modules-left": ["custom/jolly", "hyprland/workspaces"],
  "modules-center": ["clock#jordan", "clock", "clock#korea"],
  "modules-right": ["custom/cpu", "memory", "custom/gpu", "pulseaudio", "network", "tray"],

  "custom/jolly": {
    "format": "☠",
    "tooltip-format": "Open apps",
    "on-click": "rofi -show drun -show-icons"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "一", "2": "二", "3": "三", "4": "四", "5": "五",
      "6": "六", "7": "七", "8": "八", "9": "九", "10": "十"
    }
  },

  "clock": {
    "format": "⚓ {:%a %b %d  %I:%M %p}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "clock#jordan": {
    "timezone": "Asia/Amman",
    "format": "Jordan {:%I:%M %p}",
    "tooltip-format": "Jordan\n{:%A, %B %d}"
  },
  "clock#korea": {
    "timezone": "Asia/Seoul",
    "format": "South Korea {:%I:%M %p}",
    "tooltip-format": "South Korea\n{:%A, %B %d}"
  },

  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/cpu.sh",
    "return-type": "json",
    "interval": 2,
    "escape": true
  },
  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/gpu.sh",
    "return-type": "json",
    "interval": 2,
    "escape": true
  },
  "memory": {
    "format": "RAM {percentage}%",
    "interval": 2,
    "tooltip-format": "Memory\n────────────────────────\nUsed       {used:0.1f} of {total:0.1f} GB ({percentage}%)\nAvailable  {avail:0.1f} GB\nSwap       {swapUsed:0.1f} of {swapTotal:0.1f} GB"
  },
  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "MUTED",
    "tooltip-format": "{desc}\nVolume {volume}%\nClick to open sound settings",
    "on-click": "pavucontrol"
  },
  "network": {
    "interval": 2,
    "format-ethernet": "ETH",
    "format-wifi": "WIFI {signalStrength}%",
    "format-disconnected": "OFFLINE",
    "tooltip-format-ethernet": "Wired ({ifname})\nIP  {ipaddr}\n↓ {bandwidthDownBytes}   ↑ {bandwidthUpBytes}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\nIP  {ipaddr}\n↓ {bandwidthDownBytes}   ↑ {bandwidthUpBytes}"
  },
  "tray": { "spacing": 8 }
}
